{
  "name": "decalyst-swarm",
  "version": "0.1.0",
  "description": "Open-source code-generation harness pairing a frontier orchestrator with a swarm of cheap parallel workers. Multi-language, any OpenAI-compatible backend (mistral.rs, llama.cpp, ollama, OpenRouter, DeepSeek, OpenAI, etc.).",
  "type": "module",
  "license": "MIT",
  "author": "OnlyBagels <12b.pittman@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlyBagels/Decalyst-Code.git"
  },
  "bugs": {
    "url": "https://github.com/OnlyBagels/Decalyst-Code/issues"
  },
  "homepage": "https://github.com/OnlyBagels/Decalyst-Code#readme",
  "keywords": [
    "ai",
    "agent",
    "swarm",
    "code-generation",
    "orchestrator",
    "multi-language",
    "openrouter",
    "anthropic",
    "openai",
    "deepseek",
    "mistral-rs",
    "llama-cpp",
    "ollama",
    "decalyst",
    "harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "decalyst-swarm": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/typescript-estree": "^8.59.3",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "eventemitter3": "^5.0.1",
    "execa": "^9.3.0",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.52.7",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "typescript": "^5.5.3",
    "web-tree-sitter": "^0.26.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.16.2",
    "vitest": "^2.0.3"
  }
}
