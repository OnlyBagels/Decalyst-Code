# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Test artifacts
coverage/
.vitest/

# Run artifacts (keep the directory marker)
runs/*
!runs/.gitkeep

# Generated workspace output directories
workspace/
test-workspace/
out/

# Vendor agent config dirs (per-user / per-workspace, not shared via repo)
.claude/
.cursor/
.kiro/
.copilot/
.windsurf/
.continue/
.cursorrules

# Repo policy: only README.md is allowed markdown in the tree
*.md
!README.md

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temp
tmp/
temp/
.tmp-test-*

# eval artifact (its own project)
/devlog-eval/
/devlog-*.json
/devlog-*.out

# test suite kept local, not shipped in the repo
/tests/
