# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Test artifacts
coverage/
.vitest/

# Run artifacts (keep the directory marker)
runs/*
!runs/.gitkeep

# Generated workspace output directories
workspace/
test-workspace/
out/

# Claude Code local config, skills, worktrees (never shared via repo)
.claude/

# Repo policy: only README.md is allowed markdown in the tree
*.md
!README.md

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temp
tmp/
temp/
