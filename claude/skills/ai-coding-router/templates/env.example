# ai-coding-router — environment variable NAMES only. No values. Never commit a filled copy.
#
# Preferred path: store keys in the harness itself (e.g. `opencode auth login`) so they
# live at the user level, outside any repo. Use this file only if a tool needs raw env
# vars (Aider does). If you ever fill it in, keep it OUTSIDE your project repos, gitignore
# it, and `chmod 600` it. See docs/security.md.

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- MiMo ---
# Operator-supplied base URL (Anthropic-format endpoint):
#   https://token-plan-sgp.xiaomimimo.com/anthropic
# NOTE: that is the Anthropic Messages API shape. For OpenAI-compatible tools (Aider's
# openai/ prefix, decalyst's OpenAI SDK client) you need MiMo's OpenAI-compatible URL
# instead; for Anthropic-shaped clients (OpenCode @ai-sdk/anthropic, Claude-style) use the
# /anthropic URL as-is. Confirm MiMo's model ids via its /models before a paid run.
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/anthropic

# --- Generic OpenAI-compatible (used by Aider, and to point at a local model server) ---
# Aider reads OPENAI_API_KEY / OPENAI_API_BASE. The run-aider-* scripts set these per model.
OPENAI_API_KEY=
OPENAI_API_BASE=

# --- OpenCode ---
# Optional: absolute path to a non-default OpenCode config file.
OPENCODE_CONFIG=
