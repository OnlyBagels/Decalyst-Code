# =============================================================
# Decalyst-Code — Swarm worker backends (tiered)
#
#   Claude Code (Opus) is the orchestrator. It plans the file
#   list, drives the swarm via `swarm-exec`, reads results, and
#   schedules fixes. The only thing configured here is the workers.
#
#   ANY OpenAI-compatible endpoint works as a backend: DeepSeek,
#   MiMo, OpenRouter, OpenAI, Together, Groq, or a local server
#   (ollama, llama.cpp, vLLM, LM Studio, OpenCode). Just point a
#   backend's BASE_URL + API_KEY + MODEL at it.
#
#   Backends are grouped into TIERS. `swarm-exec --tier <name>`
#   runs one tier at a time:
#     bulk  -> cheap workhorses for ~80-90% of the volume
#     pro   -> stronger models for hard / important files
#   Within a tier the backends run in parallel; effective width is
#   the sum of their per-backend caps.
#
#   TO DISABLE A BACKEND: set SWARM_BACKEND_n_ENABLED=false (it is
#   kept but skipped), or just delete/comment out its lines. Gaps
#   in the numbering are fine, so you can remove backend 2 and keep
#   3 and 4.
#
#   COPY this file to `.env` and fill in the API keys. `.env` is
#   gitignored — keys live there, never in this file. The same
#   DeepSeek key works for flash and pro; same MiMo key for both.
# =============================================================

# ---------- TIER: bulk (default) ----------

# Backend 1: DeepSeek V4 Flash
SWARM_BACKEND_1_ENABLED=true
SWARM_BACKEND_1_NAME=deepseek
SWARM_BACKEND_1_BASE_URL=https://api.deepseek.com
SWARM_BACKEND_1_API_KEY=
SWARM_BACKEND_1_MODEL=deepseek-v4-flash
SWARM_BACKEND_1_CONCURRENCY=24
SWARM_BACKEND_1_THINKING=disabled
SWARM_BACKEND_1_TIER=bulk

# Backend 2: MiMo V2.5    (flip ENABLED to false to turn this provider off)
SWARM_BACKEND_2_ENABLED=true
SWARM_BACKEND_2_NAME=mimo
SWARM_BACKEND_2_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
SWARM_BACKEND_2_API_KEY=
SWARM_BACKEND_2_MODEL=mimo-v2.5
SWARM_BACKEND_2_CONCURRENCY=16
SWARM_BACKEND_2_THINKING=disabled
SWARM_BACKEND_2_TIER=bulk

# ---------- TIER: pro (--tier pro) ----------
# Stronger models, thinking ON, lower concurrency. For hard/important
# files and escalated bulk-tier failures.

# Backend 3: DeepSeek V4 Pro
SWARM_BACKEND_3_ENABLED=true
SWARM_BACKEND_3_NAME=deepseek-pro
SWARM_BACKEND_3_BASE_URL=https://api.deepseek.com
SWARM_BACKEND_3_API_KEY=
SWARM_BACKEND_3_MODEL=deepseek-v4-pro
SWARM_BACKEND_3_CONCURRENCY=12
SWARM_BACKEND_3_THINKING=enabled
SWARM_BACKEND_3_REASONING_EFFORT=high
SWARM_BACKEND_3_TIER=pro

# Backend 4: MiMo V2.5-Pro
SWARM_BACKEND_4_ENABLED=true
SWARM_BACKEND_4_NAME=mimo-pro
SWARM_BACKEND_4_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
SWARM_BACKEND_4_API_KEY=
SWARM_BACKEND_4_MODEL=mimo-v2.5-pro
SWARM_BACKEND_4_CONCURRENCY=8
SWARM_BACKEND_4_THINKING=enabled
SWARM_BACKEND_4_REASONING_EFFORT=high
SWARM_BACKEND_4_TIER=pro

# The 3-model final-review panel (Opus reconciles) reads the pro backends:
# DeepSeek V4 Pro + MiMo V2.5-Pro. See the swarm-build skill's review-panel script.

# ---------- Custom / local / other providers (examples) ----------
# Any OpenAI-compatible endpoint works. Uncomment, set keys, pick a tier.
# Numbering can have gaps; ENABLED=false keeps a backend configured but off.

# OpenRouter (one key, hundreds of models):
# SWARM_BACKEND_5_ENABLED=true
# SWARM_BACKEND_5_NAME=openrouter
# SWARM_BACKEND_5_BASE_URL=https://openrouter.ai/api/v1
# SWARM_BACKEND_5_API_KEY=
# SWARM_BACKEND_5_MODEL=qwen/qwen-2.5-coder-32b-instruct
# SWARM_BACKEND_5_CONCURRENCY=8
# SWARM_BACKEND_5_TIER=bulk

# OpenAI:
# SWARM_BACKEND_6_ENABLED=true
# SWARM_BACKEND_6_NAME=openai
# SWARM_BACKEND_6_BASE_URL=https://api.openai.com/v1
# SWARM_BACKEND_6_API_KEY=
# SWARM_BACKEND_6_MODEL=gpt-4.1-mini
# SWARM_BACKEND_6_CONCURRENCY=8
# SWARM_BACKEND_6_TIER=pro

# Local server (ollama / llama.cpp / vLLM / LM Studio / OpenCode) — no real key needed:
# SWARM_BACKEND_7_ENABLED=true
# SWARM_BACKEND_7_NAME=local
# SWARM_BACKEND_7_BASE_URL=http://localhost:11434/v1
# SWARM_BACKEND_7_API_KEY=local
# SWARM_BACKEND_7_MODEL=qwen2.5-coder:32b
# SWARM_BACKEND_7_CONCURRENCY=2
# SWARM_BACKEND_7_TIER=bulk
