# =============================================================
# decalyst-swarm — pair architecture
#
#   Orchestrator (frontier model on OpenRouter) does the THINKING:
#     - reads your user prompt
#     - plans the project
#     - reviews compiler/test errors
#     - hands narrow tasks to the local TypeScript mini
#
#   Worker (local Decalyst-TS via mistral.rs) does the WRITING:
#     - emits one TypeScript file at a time as JSON
#     - never plans, never reasons across files
# =============================================================

# --- Orchestrator: OpenRouter ---
# Get a key at https://openrouter.ai/keys
ORCHESTRATOR_API_KEY=sk-or-v1-...
ORCHESTRATOR_BASE_URL=https://openrouter.ai/api/v1
# Pick any reasoning-capable model OpenRouter exposes:
#   anthropic/claude-sonnet-4.6
#   anthropic/claude-opus-4.7
#   openai/gpt-5
#   google/gemini-2.5-pro
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4.6

# --- Worker: local Decalyst-TS via mistral.rs ---
# Start mistral.rs with the OpenAI-compatible server, e.g.:
#   mistralrs-server --port 1234 plain -m ./decalyst-ts-final
DECALYST_BASE_URL=http://localhost:1234/v1
DECALYST_API_KEY=EMPTY
DECALYST_MODEL=default

# --- Optional ---
# DECALYST_WORKSPACE=./workspace
# DECALYST_CONCURRENCY=2
# DECALYST_MAX_FIX_ROUNDS=5
