# =============================================================
# Decalyst-Code — Orchestrator + Swarm
#
#   Orchestrator: a frontier model that plans, reviews, and
#   dispatches work. Use anything reasoning-capable: Claude 4.x,
#   GPT-5, DeepSeek Reasoner, Gemini Pro, etc.
#
#   Swarm: parallel cheap workers. Any OpenAI-compatible
#   endpoint works: mistral.rs, llama.cpp server, ollama, vLLM,
#   OpenRouter, DeepSeek, Together AI, OpenAI, etc.
# =============================================================

# --- Orchestrator (planner + reviewer) ---
ORCHESTRATOR_API_KEY=sk-...
ORCHESTRATOR_BASE_URL=https://api.deepseek.com
# Example base URLs:
#   OpenRouter:  https://openrouter.ai/api/v1
#   Anthropic:   https://api.anthropic.com (use anthropic-native client)
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com
#   Local:       http://localhost:1234/v1
ORCHESTRATOR_MODEL=deepseek-reasoner

# --- Swarm (parallel workers — cheap models, local or remote) ---
SWARM_BASE_URL=http://localhost:1234/v1
SWARM_API_KEY=EMPTY
# Example local servers:
#   mistral.rs:  mistralrs-server --port 1234 plain -m ./model
#   llama.cpp:   llama-server --port 1234 -m ./model.gguf
#   ollama:      OLLAMA_HOST=0.0.0.0:1234 ollama serve
#   vLLM:        python -m vllm.entrypoints.openai.api_server --port 1234 --model ./model
# Example remote (cheap):
#   OpenRouter:  any cheap model id (e.g. anthropic/claude-haiku-4.5)
#   DeepSeek:    deepseek-chat
SWARM_MODEL=default

# --- Run settings ---
# Hard cap on parallel swarm workers (orchestrator dispatches up to this many)
SWARM_CONCURRENCY=2
# Max review-and-fix rounds before bailing
MAX_FIX_ROUNDS=5
