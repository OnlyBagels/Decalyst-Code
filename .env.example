# =============================================================
# Decalyst-Code — Swarm worker backends
#
#   Claude Code (Opus) is the orchestrator. It plans the file
#   list, drives the swarm via `swarm-exec`, reads results, and
#   schedules fixes. There is no in-repo orchestrator model — the
#   only thing configured here is the worker pool.
#
#   The swarm runs ALL backends below AT ONCE. Each backend has
#   its own model + concurrency cap; the pool routes each task to
#   the least-busy backend, so DeepSeek and MiMo saturate in
#   parallel and the effective width = sum of the per-backend caps.
#
#   COPY this file to `.env` and fill in the two API keys. `.env`
#   is gitignored — keep your keys there, never in this file.
# =============================================================

# --- Backend 1: DeepSeek (OpenAI-compatible) ---
SWARM_BACKEND_1_NAME=deepseek
SWARM_BACKEND_1_BASE_URL=https://api.deepseek.com
SWARM_BACKEND_1_API_KEY=
SWARM_BACKEND_1_MODEL=deepseek-v4-flash
SWARM_BACKEND_1_CONCURRENCY=8
# DeepSeek V4 are reasoning models; disable thinking for cheap bulk workers
# (the orchestrator already reasoned). disabled | enabled.
SWARM_BACKEND_1_THINKING=disabled
# Only when THINKING=enabled: low | medium | high | max | xhigh
SWARM_BACKEND_1_REASONING_EFFORT=

# --- Backend 2: MiMo (OpenAI-compatible) ---
SWARM_BACKEND_2_NAME=mimo
SWARM_BACKEND_2_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
SWARM_BACKEND_2_API_KEY=
SWARM_BACKEND_2_MODEL=mimo-v2.5
SWARM_BACKEND_2_CONCURRENCY=8
SWARM_BACKEND_2_THINKING=disabled
SWARM_BACKEND_2_REASONING_EFFORT=

# Add more backends by continuing the numbering: SWARM_BACKEND_3_*, etc.
# (e.g. deepseek-v4-pro / mimo-v2.5-pro for a harder-task pool.)

# -------------------------------------------------------------
# Legacy single-backend mode (used only if NO SWARM_BACKEND_n_*
# groups are set above). Leave commented when using the pool.
# -------------------------------------------------------------
# SWARM_BASE_URL=https://api.deepseek.com
# SWARM_API_KEY=
# SWARM_MODEL=deepseek-v4-flash
# SWARM_THINKING=disabled
# DECALYST_CONCURRENCY=8
